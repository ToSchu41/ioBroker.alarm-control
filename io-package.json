{
  "common": {
    "name": "alarm-control",
    "version": "0.2.0",
    "titleLang": {
      "en": "Alarm Control",
      "de": "Alarmsteuerung"
    },
    "desc": {
      "en": "Alarm areas using existing sensors, sirens and notifications",
      "de": "Sicherungsbereiche mit vorhandenen Sensoren, Sirenen und Benachrichtigungen"
    },
    "authors": [
      "ToSchu41"
    ],
    "keywords": [
      "alarm",
      "knx",
      "security"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/ToSchu41/ioBroker.alarm-control/main/admin/alarm-control.svg",
    "icon": "alarm-control.svg",
    "readme": "https://github.com/ToSchu41/ioBroker.alarm-control/blob/main/README.md",
    "loglevel": "info",
    "type": "logic",
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "adminUI": {
      "config": "json"
    },
    "supportedMessages": {},
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.6.17"
      }
    ],
    "messagebox": true,
    "news": {
      "0.2.0": {
        "de": "Sabotagekontakte, Nachrichtenvorlagen, Panik, Sensorschaltung und Benachrichtigungstests",
        "en": "Tamper contacts, message templates, panic, sensor control and notification tests"
      }
    }
  },
  "native": {
    "templateAlarm": "Alarm in {bereich}: {sensor_name} ({zone}). Zustand: {zustand}. {zeit}",
    "templateTamper": "Sabotage in {bereich}: {sensor_name}. Zustand: {zustand}. {zeit}",
    "templatePanic": "PANIK ausgelöst! {zeit}",
    "templateArming": "{bereich}: Aktivierung läuft ({modus}). Deaktivierte Sensoren: {deaktivierte_sensoren}",
    "templateArmed": "{bereich}: Anlage aktiviert ({modus}). Deaktivierte Sensoren: {deaktivierte_sensoren}",
    "templateDisarmed": "{bereich}: Anlage deaktiviert. {grund}",
    "templateBlocked": "{bereich}: Aktivierung verhindert ({modus}). {grund}. Blockierende Sensoren: {offene_sensoren}",
    "templateSensorChanged": "{bereich}: Sensor {sensor_name} ist {zustand}.",
    "templateTamperRestored": "{bereich}: Sabotagekontakt von {sensor_name} wieder normal. Gespeicherten Alarm zurücksetzen.",
    "templateReset": "{bereich}: Alarm zurückgesetzt.",
    "templatePanicReset": "Panik zurückgesetzt. {zeit}",
    "templateTest": "Testnachricht von {instanz}. {zeit}",
    "templatePhone": "{ereignis} {bereich}. {sensor_name}. {grund}",
    "notifyModeChanges": true,
    "notifyArming": false,
    "notifyBlocked": true,
    "notifySensorChanges": true,
    "tamperSirens": true,
    "panicSirens": true,
    "panicSceneId": "",
    "panicStateId": "",
    "panicActiveValue": "true",
    "historyLimit": 100,
    "timeZone": "Europe/Berlin",
    "areas": [
      {
        "id": "haus",
        "name": "Haus",
        "exitSeconds": 30
      },
      {
        "id": "garage",
        "name": "Garage",
        "exitSeconds": 30
      }
    ],
    "sensors": [],
    "sirens": [
      {
        "id": "sirene1",
        "name": "Innensirene 1",
        "enabled": false,
        "stateId": "",
        "area": "*",
        "inverted": false,
        "durationSeconds": 120
      },
      {
        "id": "sirene2",
        "name": "Innensirene 2",
        "enabled": false,
        "stateId": "",
        "area": "*",
        "inverted": false,
        "durationSeconds": 120
      }
    ],
    "recipients": [],
    "telegramEnabled": false,
    "telegramInstance": "telegram.0",
    "telegramUser": "",
    "asteriskEnabled": false,
    "asteriskInstance": "asterisk.0"
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Adapter bereit",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
